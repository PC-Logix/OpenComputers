      }
    },
    {
      "apply": {
        "model": "opencomputers:block/cable_disconnected",
        "x": 90,
        "y": 90
      },
      "when": {
        "OR": [
          {
            "conn_down": "none",
            "conn_east": "none",
            "conn_north": "none",
            "conn_south": "none",
            "conn_up": "none",
            "conn_west": "none"
          },
          {
            "conn_down": "none",
            "conn_east": "none",
            "conn_north": "none",
            "conn_south": "none",
            "conn_up": "cable|device",
            "conn_west": "none"
