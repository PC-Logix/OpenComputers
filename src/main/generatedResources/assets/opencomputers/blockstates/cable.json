{
  "multipart": [
    {
      "apply": {
        "model": "opencomputers:block/cable_core"
      }
    },
    {
      "apply": {
        "model": "opencomputers:block/cable_arm_cable",
        "x": 90,
        "y": 90
      },
      "when": {
        "conn_down": "cable"
      }
    },
    {
      "apply": {
        "model": "opencomputers:block/cable_arm_device",
        "x": 90,
        "y": 90
      },
      "when": {
